FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app

# Paketleri önden restore etmek için önce csproj dosyasını kopyalayabiliriz
# Veya repodaki tüm yapıyı korumak için doğrudan volume kullanabiliriz.
EXPOSE 8080

CMD ["sh", "-c", "dotnet restore StreamWorker.csproj && dotnet watch run --project StreamWorker.csproj --no-launch-profile"]