FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app

RUN dotnet tool install --global dotnet-ef
ENV PATH="${PATH}:/root/.dotnet/tools"

EXPOSE 8080

CMD ["sh", "-c", "dotnet restore AdminApi.Api/AdminApi.Api.csproj && dotnet build AdminApi.Api/AdminApi.Api.csproj --no-restore -v:diag > /app/build-diag.log 2>&1; dotnet watch run --project AdminApi.Api/AdminApi.Api.csproj --no-launch-profile --urls=http://0.0.0.0:8080"]
